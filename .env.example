# Copy this file to ".env" to run with real email locally:  copy .env.example .env
# On a host (Fly/Render/Railway/VPS), set these as environment variables instead.

# Port the server listens on (most hosts set this automatically).
PORT=3000

# Where the database + secret keys are stored. On a host, point this at a
# PERSISTENT disk/volume so data survives restarts (e.g. /data).
DATA_DIR=./data

# Set to 1 when running behind a host's proxy so rate-limiting sees real
# visitor IPs. Leave unset when running directly on your own PC.
TRUST_PROXY=1

# false (default) = only the first user + admin-added staff can sign in.
# true            = anyone with a valid email can sign themselves up.
ALLOW_OPEN_REGISTRATION=false

# ----- Email for login codes (so codes go to real inboxes) -----
# Example below is Gmail with an App Password (needs 2-step verification ON,
# then create an App Password at https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=TF Communication <youraddress@gmail.com>

# ----- Email via Brevo web API (recommended on hosts that block SMTP, e.g. Render free) -----
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER=youraddress@gmail.com

# ----- File sharing via Cloudinary (photos / videos / files in chat) -----
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret
